# Copy this file to .env and fill in the values. Never commit .env.

# Groq API key (console.groq.com)
GROQ_API_KEY=

# Postgres connection string (Supabase: Connect -> Session pooler -> URI)
DATABASE_URL=

# bcrypt hashes, one per account. Generate each with:
#   python -c "from app.auth import pwd_context; print(pwd_context.hash('choose-a-password'))"
AUTH_HASH_USER1=
AUTH_HASH_USER2=
AUTH_HASH_COORDINATOR=
AUTH_HASH_DEMO=

# Optional
# LOCK_EVAL_PACKAGES=1          # make P01-P10 read-only for everyone
# DEMO_DAILY_AUDIT_LIMIT=20     # audits the demo account may run per day

# UI service only (on Render, set this as an environment variable on the UI service):
# API_URL=https://your-service.onrender.com
